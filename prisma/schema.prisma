// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      String   @default("Siswa") // Super Admin, Panitia PPDB, Guru, Siswa
  status    String   @default("Aktif") // Aktif, Nonaktif
  nisn      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Berita {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  category  String
  authorId  String
  status    String   @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Jurusan {
  id          String   @id @default(cuid())
  name        String
  code        String
  kuota       Int
  description String
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Portofolio {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  authorName  String
  category    String
  createdAt   DateTime @default(now())
}

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
}

model PpdbApplicant {
  id             String @id @default(cuid())
  jalur          String // normal, afirmasi, beasiswa
  fullName       String
  nisn           String @unique
  birthInfo      String
  gender         String
  address        String
  phone          String
  previousSchool String
  major          String

  // Dokumen / Input Khusus
  afirmasiNumber   String?
  kipNumber        String?
  prestasiType     String?
  documentKk       String?
  documentAfirmasi String?
  documentKip      String?
  documentPrestasi String?

  // Status Pembayaran & Pendaftaran
  paymentStatus String    @default("UNPAID") // UNPAID, PENDING_TRANSFER, PENDING_CASH, PAID, REJECTED
  paymentMethod String?   // TRANSFER, CASH
  paymentProof  String?   // URL Bukti Transfer Struk/M-Banking
  paymentAmount Int?      @default(150000)
  paymentDate   DateTime? // Tanggal Bayar / Tanggal Verifikasi
  verifiedBy    String?   // Petugas / Verifikator yang menyetujui
  paymentNotes  String?   // Catatan kasir / no kwitansi fisik
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alumni {
  id             String  @id @default(cuid())
  nisn           String  @unique
  fullName       String
  graduationYear Int
  major          String
  phone          String?
  email          String?

  tracerStudy TracerStudy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TracerStudy {
  id       String @id @default(cuid())
  alumniId String @unique
  alumni   Alumni @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  status String // BEKERJA, KULIAH, WIRAUSAHA, MENCARI_KERJA

  // Jika Bekerja / Wirausaha
  companyName String?
  jobTitle    String?
  salary      String?

  // Jika Kuliah
  university String?
  faculty    String?

  // Feedback
  relevance   String? // Sangat Erat, Erat, Cukup, Kurang, Tidak Sama Sekali
  suggestions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobListing {
  id           String           @id @default(cuid())
  title        String
  company      String
  location     String
  salary       String?
  type         String // Full-time, Part-time, Kontrak, Magang
  description  String
  requirements String?          @db.Text
  tags         String // comma separated tags
  department   String?          @default("Semua Jurusan")
  contactEmail String?
  contactWa    String?
  deadline     DateTime?
  isHot        Boolean          @default(false)
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id             String      @id @default(cuid())
  jobId          String
  job            JobListing  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String
  nisn           String?
  lastEducation  String?
  graduationYear Int?
  resumeUrl      String?
  portfolioUrl   String?
  coverLetter    String?     @db.Text
  status         String      @default("PENDING") // PENDING, REVIEWED, INTERVIEW, ACCEPTED, REJECTED
  adminNotes     String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UploadedFile {
  id        String   @id @default(cuid())
  fileName  String
  fileType  String
  fileSize  Int
  fileData  String   @db.Text
  createdAt DateTime @default(now())
}

model Exam {
  id               String         @id @default(cuid())
  title            String
  subject          String
  classTarget      String         @default("Semua Kelas")
  duration         Int            @default(60) // dalam menit
  token            String?        // Token masuk ujian, misal "SMK2026"
  description      String?        @db.Text
  status           String         @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  shuffleQuestions Boolean        @default(true)
  authorName       String?
  startTime        DateTime?      // Jadwal Mulai Ujian
  endTime          DateTime?      // Jadwal Selesai Ujian
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  questions        ExamQuestion[]
  attempts         ExamAttempt[]
}

model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String   @db.Text
  options       String   @db.Text // JSON string: ["Pilihan A", "Pilihan B", "Pilihan C", "Pilihan D"]
  correctAnswer String   // Index opsi yang benar: "0", "1", "2", "3"
  points        Int      @default(10)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model ExamAttempt {
  id             String    @id @default(cuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentName    String
  studentNis     String?
  studentClass   String?
  answers        String    @default("{}") @db.Text // JSON string: { "questionId": "0" }
  score          Float     @default(0)
  totalQuestions Int       @default(0)
  totalCorrect   Int       @default(0)
  status         String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
  tabSwitchCount Int       @default(0) // Anti-curang hitung buka tab lain
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
}

model Assignment {
  id          String                 @id @default(cuid())
  title       String
  subject     String
  classTarget String                 @default("Semua Kelas")
  description String                 @db.Text
  deadline    DateTime
  fileUrl     String?                // Dokumen/lampiran instruksi tugas
  status      String                 @default("ACTIVE") // ACTIVE, CLOSED
  authorName  String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentName  String
  studentNis   String?
  studentClass String?
  notes        String?    @db.Text
  fileUrl      String?    @db.Text // Link / file upload hasil tugas
  fileName     String?
  submittedAt  DateTime   @default(now())
  grade        Float?
  feedback     String?    @db.Text
  status       String     @default("SUBMITTED") // SUBMITTED, GRADED, LATE
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String   @default("Muatan Kejuruan") // Muatan Kejuruan, Muatan Nasional, Muatan Kewilayahan
  classTarget String   @default("XI RPL 1")
  teacherId   String?  // Id User guru pengampu (jika ada)
  teacherName String?  // Nama Guru Pengampu (e.g. "Abdul Rahman", "Bpk. Ahmad ST")
  day         String?  // Hari: "Senin", "Selasa", "Rabu", "Kamis", "Jumat"
  time        String?  // Jam: "07:30 - 10:00"
  room        String?  // Ruang: "Lab Komputer 1"
  kkm         Int      @default(75)
  credits     Int      @default(4) // Jam Pelajaran (JP)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grades      StudentGrade[]
}

model StudentGrade {
  id           String   @id @default(cuid())
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId    String?
  studentName  String
  studentNis   String?
  studentClass String   @default("XI RPL 1")
  assignment   Float    @default(85) // Tugas & Kuis
  midExam      Float    @default(80) // UTS (PTS)
  finalExam    Float    @default(85) // UAS (PAS)
  finalGrade   String   @default("A") // A, A-, B+, B, C, D
  notes        String?  @db.Text
  updatedBy    String?  // Nama penginput nilai (Guru Pengampu / Admin)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subjectId, studentName])
}


