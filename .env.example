# ==============================================================================
# SMK WEB & PPDB ONLINE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env atau .env.local:
# cp .env.example .env.local

# Database Connection URL (Prisma Postgres / Supabase / Neon / Local PostgreSQL)
POSTGRES_PRISMA_DATABASE_URL="postgres://username:password@localhost:5432/smk_db?sslmode=prefer"
POSTGRES_URL="postgres://username:password@localhost:5432/smk_db?sslmode=prefer"

# Google Gemini API Key (Opsional: untuk asisten AI interaktif SMK)
GEMINI_API_KEY=""

# Environment Mode
NODE_ENV="development"
